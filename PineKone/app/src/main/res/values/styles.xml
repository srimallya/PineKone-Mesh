<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.PineKone.Display" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/pk_pine_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.PineKone.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/pk_pine_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.PineKone.SectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/pk_pine_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PineKone.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_theme_on_surface</item>
    </style>

    <style name="TextAppearance.PineKone.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/md_theme_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.PineKone.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/pk_canvas</item>
        <item name="titleTextColor">@color/pk_pine_dark</item>
        <item name="subtitleTextColor">@color/md_theme_on_surface_variant</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.PineKone.SurfaceCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/pk_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeColor">@color/md_theme_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.PineKone.HighlightCard" parent="Widget.PineKone.SurfaceCard">
        <item name="cardBackgroundColor">@color/pk_surface_alt</item>
    </style>

    <style name="Widget.PineKone.MessageCard.Incoming" parent="Widget.PineKone.SurfaceCard">
        <item name="cardBackgroundColor">@color/pk_surface_alt</item>
    </style>

    <style name="Widget.PineKone.MessageCard.Outgoing" parent="Widget.PineKone.SurfaceCard">
        <item name="cardBackgroundColor">@color/md_theme_primary_container</item>
    </style>

    <style name="Widget.PineKone.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/md_theme_outline</item>
        <item name="android:textColor">@color/md_theme_on_surface</item>
    </style>

    <style name="Widget.PineKone.PrimaryButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.PineKone.TonalButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/pk_surface_raised</item>
        <item name="android:textColor">@color/md_theme_on_surface</item>
    </style>

    <style name="Widget.PineKone.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">10dp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <style name="Widget.PineKone.StatusChip" parent="Widget.PineKone.Chip">
        <item name="android:checkable">false</item>
    </style>

    <style name="Widget.PineKone.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.Material3.TitleSmall</item>
        <item name="tabTextColor">@color/md_theme_on_surface_variant</item>
        <item name="tabSelectedTextColor">@color/md_theme_on_surface</item>
        <item name="tabIndicatorColor">@color/md_theme_primary</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabRippleColor">@android:color/transparent</item>
    </style>

    <style name="Widget.PineKone.InputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/pk_surface</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/md_theme_outline</item>
        <item name="hintTextColor">@color/md_theme_on_surface_variant</item>
        <item name="android:textColorHint">@color/md_theme_on_surface_variant</item>
    </style>

    <style name="Widget.PineKone.ToggleGroup" parent="Widget.Material3.MaterialButtonToggleGroup">
        <item name="singleSelection">true</item>
    </style>
</resources>
