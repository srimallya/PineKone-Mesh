<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.PineKone.Display" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/pk_pine_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PineKone.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/pk_pine_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PineKone.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_theme_on_surface</item>
    </style>

    <style name="TextAppearance.PineKone.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/md_theme_on_surface_variant</item>
    </style>

    <style name="Widget.PineKone.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/pk_canvas</item>
        <item name="titleTextColor">@color/pk_pine_dark</item>
        <item name="subtitleTextColor">@color/md_theme_on_surface_variant</item>
    </style>

    <style name="Widget.PineKone.SurfaceCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/md_theme_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="strokeColor">@color/md_theme_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.PineKone.HighlightCard" parent="Widget.PineKone.SurfaceCard">
        <item name="cardBackgroundColor">@color/md_theme_surface_variant</item>
    </style>

    <style name="Widget.PineKone.MessageCard.Incoming" parent="Widget.PineKone.SurfaceCard">
        <item name="cardBackgroundColor">@color/md_theme_surface</item>
    </style>

    <style name="Widget.PineKone.MessageCard.Outgoing" parent="Widget.PineKone.SurfaceCard">
        <item name="cardBackgroundColor">@color/md_theme_primary_container</item>
    </style>

    <style name="Widget.PineKone.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.PineKone.PrimaryButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.PineKone.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
