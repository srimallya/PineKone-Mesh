<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pk_canvas">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pk_canvas"
        android:paddingTop="8dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/pk_canvas"
            android:paddingHorizontal="8dp"
            android:title="@string/home_title" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/homeStatusCard"
            style="@style/Widget.PineKone.SurfaceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/homeStatusHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/homeStatusDetails"
                    android:textAppearance="@style/TextAppearance.PineKone.Title"
                    android:textColor="@color/md_theme_on_surface" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/homeStatusSubline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/homeStatusHeadline"
                    android:layout_alignStart="@id/homeStatusHeadline"
                    android:layout_toStartOf="@id/homeStatusDetails"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.PineKone.Meta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/homeStatusDetails"
                    style="@style/Widget.PineKone.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/home_status_open_details_short" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/homeStatusChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/homeStatusSubline"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleLine="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/homeChipDisclosure"
                        style="@style/Widget.PineKone.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_status_chip_disclosure" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/homeChipTransport"
                        style="@style/Widget.PineKone.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/homeChipCustody"
                        style="@style/Widget.PineKone.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </com.google.android.material.chip.ChipGroup>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/homeTabs"
            style="@style/Widget.PineKone.TabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            app:tabIndicatorFullWidth="false" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homePager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabInvite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/invite_title"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/md_theme_primary"
        app:tint="@color/md_theme_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
